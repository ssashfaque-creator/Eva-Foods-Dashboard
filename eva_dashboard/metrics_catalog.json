{
  "version": "1.0",
  "description": "Governed semantic metrics/dimensions for Eva Foods plan_query. Synonyms map spoken management language onto canonical QuerySpec fields.",
  "metrics": {
    "volume": {
      "label": "Volume (MT)",
      "description": "Sales volume in metric tons (effective MT).",
      "synonyms": [
        "volume",
        "sales",
        "mt",
        "tonnage",
        "qty",
        "quantity",
        "how much sold",
        "how much did they buy"
      ]
    },
    "ams": {
      "label": "AMS",
      "description": "Average monthly sales — mean of the 3 full calendar months before the focus month. 'AMS > 10' / '10 MT AMS' filters this KPI, not period volume.",
      "synonyms": [
        "ams",
        "average monthly sales",
        "monthly average",
        "baseline ams",
        "ams baseline"
      ]
    },
    "vs_ams": {
      "label": "% vs AMS",
      "description": "Period volume versus AMS baseline as a percentage.",
      "synonyms": [
        "vs ams",
        "versus ams",
        "against ams",
        "% vs ams",
        "% of ams",
        "% of their ams",
        "percent of ams",
        "percentage of ams",
        "pct vs ams",
        "performance vs ams",
        "behind on ams",
        "falling behind on ams",
        "lowest performing",
        "worst performing"
      ],
      "default_sort": "asc",
      "implies_row": "party"
    },
    "ams_growth": {
      "label": "AMS growth",
      "description": "Growth versus prior AMS window (current 3-month AMS vs the previous 3-month AMS). Not calendar YoY of a spoken last-N-months span.",
      "synonyms": [
        "ams growth",
        "growth vs ams",
        "gains",
        "least gains",
        "lowest gains",
        "biggest gains",
        "grew",
        "growth"
      ]
    },
    "yoy": {
      "label": "Volume YoY %",
      "description": "Calendar year-over-year of the spoken window (last N months vs the same N months last year, or a named month vs that month last year).",
      "synonyms": [
        "yoy",
        "year over year",
        "year on year",
        "vs last year",
        "versus last year",
        "same period last year",
        "same months last year"
      ],
      "implies_row": "party"
    },
    "yoy_ams": {
      "label": "Volume YoY + AMS",
      "description": "Calendar YoY of the spoken window plus AMS columns.",
      "synonyms": [
        "yoy and ams",
        "ams and yoy"
      ],
      "implies_row": "party"
    },
    "avg_price": {
      "label": "Average rate",
      "description": "MT-weighted average selling rate from sales lines.",
      "synonyms": [
        "avg price",
        "average price",
        "avg rate",
        "average rate",
        "selling price",
        "rate",
        "what's the price",
        "what is the price",
        "price"
      ]
    },
    "last_price": {
      "label": "Last sold price",
      "description": "Incl GST/FED per sellable unit on the most recent sales invoice for each SKU (not a period average), with that sale date.",
      "synonyms": [
        "last price",
        "last price sold",
        "last sold price",
        "latest price",
        "most recent price",
        "last selling price",
        "price date of sale",
        "sale date",
        "date of sale"
      ],
      "implies_row": "product"
    },
    "price_fetch": {
      "label": "Price Fetch (Rs/maund)",
      "description": "(Incl GST/kg − cost factor/kg) × 37.3246. Engine owns the math.",
      "synonyms": [
        "price fetch",
        "pricefetch",
        "oil price fetched",
        "recovery",
        "apply the cost factor",
        "cost factor price",
        "pf"
      ]
    }
  },
